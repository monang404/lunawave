  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "esbuild web/static/js/main.js --bundle --minify --outfile=web/static/js/bundle.js --platform=browser --format=iife --pure:console.log",
    "build:css": "esbuild web/static/css/main.css --bundle --minify --outfile=web/static/css/bundle.css",
    "build:watch": "npm run build:js -- --watch & npm run build:css -- --watch",
