YTGUI_HOST=0.0.0.0
YTGUI_PORT=8765
YTGUI_ADMIN_USER=admin
# Jika password tidak di-set, sistem akan men-generate password otomatis pada saat run pertama.
# YTGUI_ADMIN_PASS=your_secret_password

# Direktori utama tempat YTGUI menyimpan cache, db, dll.
YT_PLAYER_BASE=.

# Lokasi socket IPC untuk komunikasi dengan proses mpv.
YT_PLAYER_SOCKET=/tmp/mpv-ytgui.sock

# Volume default awal
YT_PLAYER_VOLUME=100

# IP Proxy jika berada dibalik NGINX/Apache (untuk mencatat IP sebenarnya)
TRUSTED_PROXY=127.0.0.1

# Token keamanan untuk endpoint Prometheus /metrics (bila diakses diluar localhost)
# YTGUI_METRICS_TOKEN=your_metrics_secret
