# ============================================================
# LunaWave — Konfigurasi Environment
# Salin file ini menjadi .env lalu sesuaikan nilainya
# cp .env.example .env
# ============================================================

# Server
LUNAWAVE_HOST=0.0.0.0
LUNAWAVE_PORT=8765

# Login — ganti dengan password yang mudah kamu ingat
LUNAWAVE_ADMIN_USER=admin
LUNAWAVE_ADMIN_PASS=ganti_password_ini

# Direktori utama (biasanya tidak perlu diubah)
LUNAWAVE_BASE=.

# MPV socket
LUNAWAVE_SOCKET=./cache/sockets/mpv-yt-player.sock

# Volume default
LUNAWAVE_VOLUME=80

# Proxy (set ke true jika di belakang NGINX/Caddy)
TRUSTED_PROXY=false

# Prometheus metrics token (opsional)
# LUNAWAVE_METRICS_TOKEN=your_metrics_secret
